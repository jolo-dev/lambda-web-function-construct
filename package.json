    "tsc": {
      "rootDir": "src",
      "outDir": "lib"
    }
  },
  "dependencies": {
    "zod": "^4.4.3"
  },
  "bundledDependencies": ["zod"],
  "peerDependencies": {
    "aws-cdk-lib": "^2.274.0",
    "constructs": "^10.6.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "aws-cdk-lib": "2.274.0",
    "constructs": "10.6.0",
    "jsii": "^6.0.19",
    "jsii-pacmak": "^1.142.0",
    "typescript": "^5.9.3"
  }
}
