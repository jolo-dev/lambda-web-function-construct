{
  "name": "lambda-web-function-construct",
  "version": "0.1.0",
  "description": "An AWS CDK construct for deploying Lambda Web Functions.",
  "author": "John Nguyen",
  "repository": {
    "type": "git",
    "url": "https://github.com/jolo-dev/lambda-web-function-construct.git"
  },
  "license": "MIT",
  "keywords": [
    "aws-cdk",
    "awscdk",
    "lambda",
    "web-functions",
    "construct"
  ],
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "files": [
    "lib/**/*.js",
    "lib/**/*.d.ts",
    ".jsii",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "jsii",
    "prepack": "bun run build",
    "test": "bun test",
